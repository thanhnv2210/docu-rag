# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg connection string
DATABASE_URL=postgresql://docu_rag:docu_rag@localhost:5432/docu_rag

# ── LLM Provider ──────────────────────────────────────────────────────────────
# "ollama" (default, no API key required) or "anthropic"
LLM_PROVIDER=ollama

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Anthropic (optional — only required when LLM_PROVIDER=anthropic) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-haiku-4-5-20251001

# ── Embeddings ────────────────────────────────────────────────────────────────
# 768 for nomic-embed-text (Ollama default)
# 1536 for voyage-3 (Anthropic) — also requires recreating the DB schema
EMBED_DIMS=768

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
